{
    "compilerOptions": {
        "target": "esnext",
        "sourceMap": true,
        "module": "commonjs",
        "outDir": "./dist",
        "moduleResolution": "node",
        "jsx": "react",
        "isolatedModules": false,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "declaration": false,
        "noImplicitAny": false,
        "removeComments": true,
        "preserveConstEnums": true,
        "noEmitOnError": true,
        "strictNullChecks": true,
        "types" : [
            "jasmine"
        ]
    },
    "exclude": [
        "**/node_modules/*",
        "**/lib/typings/*",
        "**/*.d.ts"
    ]
}